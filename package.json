{
    "name": "academic-project-page",
    "version": "1.0.0",
    "description": "Academic project page template for GitHub Pages",
    "main": "index.html",
    "scripts": {
        "start": "npx http-server public -p 8080 -o",
        "build": "npm run copy-files",
        "copy-files": "mkdir -p dist && cp -r public/* dist/ 2>/dev/null || true",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist",
        "clean": "rm -rf dist"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/YOUR_USERNAME/YOUR_REPO_NAME.git"
    },
    "keywords": [
        "academic",
        "research",
        "project-page",
        "github-pages"
    ],
    "author": "Your Name",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/YOUR_USERNAME/YOUR_REPO_NAME/issues"
    },
    "homepage": "https://YOUR_USERNAME.github.io/YOUR_REPO_NAME/",
    "devDependencies": {
        "gh-pages": "^6.1.0",
        "http-server": "^14.1.1"
    },
    "dependencies": {
        "simple-mind-map": "^0.14.0-fix.1"
    }
}
